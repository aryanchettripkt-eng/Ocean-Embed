# Data directory where manifest.json and prediction stores reside
DATA_DIR=/data/outputs

# Optional Hugging Face Dataset repository to download from at startup if DATA_DIR is empty
HF_DATASET_REPO=
HF_DATASET_REVISION=main
HF_TOKEN=

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Meta features: "Talk to the ocean" guide (PRD_BACKEND §3, §6)
# META_CLIENT=mock runs the offline guide (no key, no network) for local and frontend work.
CHAT_ENABLED=false
META_CLIENT=http
META_API_BASE_URL=
META_API_KEY=
META_CHAT_MODEL=muse-spark-1.3
META_CHAT_FALLBACK_MODEL=
META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
META_IMAGE_MODEL=muse-image-1.0
META_SEGMENT_MODEL=
PROVIDER_LABEL=Muse Spark via Meta Model API
SEGMENT_PROVIDER=sam
CHAT_RATE_LIMIT=10/minute
CHAT_DAILY_CAP=500
# Voice input: POST /transcribe (PRD_BACKEND §4.13). Needs META_TRANSCRIBE_MODEL unless META_CLIENT=mock.
VOICE_ENABLED=false
VOICE_RATE_LIMIT=6/minute
VOICE_DAILY_CAP=300
# Postcards: POST /postcard (PRD_BACKEND §4.15). Needs META_IMAGE_MODEL unless META_CLIENT=mock.
POSTCARD_ENABLED=false
POSTCARD_RATE_LIMIT=3/minute
POSTCARD_DAILY_CAP=100
# Empty = <system temp>/oceanscope-postcards (ephemeral is fine; never inside the repo)
POSTCARD_CACHE_DIR=
# Lasso: POST /segment (§4.16). Uses SAM when SEGMENT_PROVIDER=sam and META_SEGMENT_MODEL is set
# (or META_CLIENT=mock); otherwise the similar-temperature threshold method.
SEGMENT_ENABLED=false
SEGMENT_THRESHOLD_C=0.5
SEGMENT_RATE_LIMIT=10/minute
SEGMENT_DAILY_CAP=300
# Beach mode: GET /nearest-ocean (§4.17). No Meta model involved.
BEACH_ENABLED=false

# Periodic reload interval in minutes (0 to disable)
RELOAD_INTERVAL_MIN=60

# Logging
LOG_LEVEL=INFO
