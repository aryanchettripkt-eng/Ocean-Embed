# Copy to .env.local (git-ignored) and edit. Every variable the frontend reads is listed here.
# NEXT_PUBLIC_* values are baked into the browser bundle: never put a secret in one.
# The frontend has no secrets; API keys (Meta, Hugging Face) live only in the backend.

# Backend API base URL. "/api/v1" is appended if missing.
# Deployed backend on Render (allows http://localhost:3000 via CORS; the first request after
# it has been idle can take about a minute while the free instance wakes up):
NEXT_PUBLIC_API_BASE_URL=https://oceanscope-backend.onrender.com/api/v1
# Local backend on the synthetic fixtures (see README "Frontend quickstart"):
# NEXT_PUBLIC_API_BASE_URL=http://localhost:7860/api/v1
# Unset, the code falls back to http://localhost:8000/api/v1.

# true = no backend at all: every API call is answered in the browser by MSW mocks
# (src/mocks/), on synthetic data. Restart `pnpm dev` after changing it.
NEXT_PUBLIC_USE_MOCKS=false

# Only used when NEXT_PUBLIC_USE_MOCKS=true: true turns on every Meta feature flag in the mocked
# /meta response (guide chat, voice, postcards, lasso, beach mode) so you can build those UIs
# offline. With a real backend the flags come from the backend's /meta response instead.
NEXT_PUBLIC_MOCK_META_FEATURES=false

# Public site URL for Open Graph / metadata links. Defaults to https://ocean-embed-xi.vercel.app.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Test-only variables (set in the shell, not here):
#   PLAYWRIGHT_TEST_BASE_URL  e2e base URL (default http://localhost:3000; landing config 3001)
#   NO_WEBSERVER=1            don't let Playwright start `pnpm dev` (use your running server)
